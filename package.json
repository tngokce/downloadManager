{
  "name": "gokce-download-manager",
  "productName": "Gökçe Download Manager",
  "version": "1.0.0",
  "description": "Gökçe Download Manager — çok bağlantılı, kaldığı yerden devam eden, tarayıcı entegrasyonlu masaüstü indirme yöneticisi (Windows + macOS)",
  "author": {
    "name": "Tunahan Gökçe",
    "url": "https://github.com/tngokce"
  },
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "homepage": "https://github.com/tngokce/downloadManager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tngokce/downloadManager.git"
  },
  "bugs": {
    "url": "https://github.com/tngokce/downloadManager/issues"
  },
  "keywords": [
    "download-manager",
    "downloader",
    "electron",
    "multi-connection",
    "resume",
    "hls",
    "browser-extension",
    "windows",
    "macos"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "electron scripts/make-icons.mjs",
    "extension": "node scripts/build-extension.mjs",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac -c.productName=\"Gokce Download Manager\" -c.mac.extendInfo.CFBundleDisplayName=\"Gökçe Download Manager\"",
    "dist:win": "npm run build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "basic-ftp": "^6.2.3",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
